HOST_MEDIA_PATH=/path/to/your/music
MEDIA_PATH=/media
PUID=1000
PGID=1001
DOCKER_NETWORK=music_net

NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USER=admin
NAVIDROME_PASSWORD=change-me

# Explicit ratings 1..X are moved. Unrated songs are never matched.
DELETE_BY_RATING=false
MAX_RATING=1

# Navidrome favorite/starred songs are moved.
DELETE_LIKED=false

# Keep true for the first run; logs candidates without moving files.
DRY_RUN=true
POLL_INTERVAL=300
